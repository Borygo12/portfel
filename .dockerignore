# Im mniej wchodzi do obrazu, tym szybszy build i mniejsze ryzyko, że coś
# prywatnego wyjedzie razem z kodem.

.git/
.github/
.claude/

# sekrety — do kontenera trafiają zmiennymi środowiskowymi, nigdy plikiem
keys/
.env
*.env
!*.env.example

# aplikacja mobilna ma własne repozytorium i własny build
mobile/
node_modules/

# dane robocze i lokalna baza — w chmurze pochodzą z dysku i z Supabase
bot/portfolio_data/
bot/live_logs/
bot/backtests/
bot/*.log
bot/signals.jsonl
bot/heartbeat.json
bot/params.json
bot/mentions.json
bot/live_events.json
bot/sources/sitemap_state.json

# moduł /live nie jedzie do chmury
bot/requirements-live.txt

# narzędzia uruchamiane wyłącznie na komputerze — serwer ich nie woła,
# a ciągną zależności (Pillow), których nie ma po co instalować w obrazie
bot/make_icon.py
bot/launch_lan.vbs
bot/_test_squawk.py

__pycache__/
*.pyc
.expo/
dist/

# grafika i dokumentacja nie są potrzebne serwerowi
tła/
/*.png
/*.ico
bot/*.png
bot/*.ico

# Zbudowana aplikacja wchodzi do obrazu W CALOSCI — jej grafika i ikona są
# częścią interfejsu, a nie dokumentacją. Ten wyjątek stoi na końcu celowo:
# w .dockerignore wygrywa ostatnia pasująca reguła.
!web/**
README.md
