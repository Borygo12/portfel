# To jest tylko WZORZEC. Prawdziwe dane trzymaj w pliku .env (bot czyta .env).

# Wybór brokera:
#   "saxo"    — akcje GPW (CFD), krypto, akcje US/EU. JEDYNY z realnym API na GPW.
#   "mt5"     — XM / Admirals / Pepperstone: akcje US/EU, bez GPW.
#   "capital" — Capital.com.
#   ("xtb" — API wyłączone dla retailu od 03.2025, nie działa; kod został na wszelki wypadek)
# Puste = autodetekcja po wypełnionych kluczach.
BROKER=mt5

# --- Saxo Bank OpenAPI — akcje GPW (CFD: dźwignia + short), krypto, akcje US/EU ---
# SIM (demo): token 24h z developer.saxo. LIVE: appka OAuth (client id/secret + refresh).
SAXO_ENV=sim             # sim = demo, live = realne
SAXO_TOKEN=              # 24h token (SIM) z developer.saxo; produkcja: OAuth
# UWAGA: żywe ceny GPW przez API wymagają subskrypcji danych WSE (parę €/mc).
#        Bez niej działa tryb "bracket" (SL/TP server-side), ale bez żywej wyceny w trakcie.

# --- XTB xStation (xAPI) — NIE DZIAŁA dla retailu (API wyłączone 03.2025) ---
# Przełącznik XTB_DEMO wybiera, które dane są używane (oba możesz wpisać naraz).
XTB_DEMO=true            # true = konto demo, false = realne
XTB_DEMO_USER_ID=        # numer konta demo xStation, np. 12345678
XTB_DEMO_PASSWORD=
XTB_REAL_USER_ID=        # dedykowane konto bota (wypełnij po testach na demo)
XTB_REAL_PASSWORD=
# XTB_WS_HOST=ws.xapi.pro   # domyślnie ws.xapi.pro (stary ws.xtb.com wyłączony 03.2025)

# --- MetaTrader 5 (dane konta z maila od brokera) ---
MT5_LOGIN=               # numer konta, np. 51234567
MT5_PASSWORD=
MT5_SERVER=              # np. XM.COM-MT5 (podane w mailu)
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe   # tylko jeśli niestandardowa lokalizacja

# Analiza postów — OpenRouter (openrouter.ai -> Keys). Ma priorytet nad Anthropic.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b:free       # główny darmowy model etapu 1
# PAID_FAST_MODEL=google/gemini-2.5-flash         # płatny fallback gdy darmowe padną (kredyty)
# VERIFY_MODEL=anthropic/claude-sonnet-5          # mocny model weryfikujący trade po wejściu (kredyty)

# Wystąpienia na żywo (/live) — model do analizy transkrypcji streamów
# LIVE_MODEL=google/gemini-2.5-flash             # szybki model główny
# LIVE_FALLBACK_MODEL=anthropic/claude-sonnet-5  # mocniejszy zapas, gdy główny padnie

# Analiza postów — zapas (Anthropic)
ANTHROPIC_API_KEY=

# Truth Social (scraper)
SCRAPECREATORS_API_KEY=

# Kongres (faza 3)
QUIVER_API_KEY=
