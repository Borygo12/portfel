# To jest tylko WZORZEC. Prawdziwe dane trzymaj w pliku .env (bot czyta .env),
# a w Railway — w zakładce Variables. Nigdy w repozytorium.
#
# Serwer NASŁUCHUJE i ANALIZUJE wiadomości oraz liczy portfele. Nie łączy się
# z żadnym brokerem i nie składa zleceń — dlatego nie ma tu kluczy maklerskich.

# =============================================================== BAZA (wymagane)
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler".
# Port 6543, nie 5432: darmowy plan ma mało bezpośrednich połączeń, a pooler je dzieli.
# Hasło do bazy wstaw w miejsce [YOUR-PASSWORD].
SUPABASE_DB_URL=

# =============================================================== KONTA (wymagane)
# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Klucz serwisowy omija RLS — TYLKO na serwerze, nigdy w aplikacji mobilnej ani w web.
SUPABASE_SERVICE_KEY=

# Twój adres e-mail: to konto ma premium i podgląd bez premium bez żadnych nadań.
OWNER_EMAIL=

# =========================================================== DOSTĘP I BEZPIECZEŃSTWO
# Token dla telefonu właściciela. W chmurze ustaw własny, długi ciąg — inaczej
# przy każdym wdrożeniu wygeneruje się nowy i telefon straci połączenie.
PANEL_API_TOKEN=

# 1 = logowanie wymagane zawsze, także z tego komputera. W chmurze włącza się samo.
# REQUIRE_AUTH_LOCAL=0

# Adresy, z których aplikacja web może pytać serwer. Pusto = wszystkie (wygodne
# w developmencie). Na produkcji podaj swoje domeny po przecinku.
# ALLOWED_ORIGINS=https://portevo.pl,https://app.portevo.pl

# ================================================================= ANALIZA AI
# OpenRouter (openrouter.ai -> Keys). Ma priorytet nad Anthropic.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b:free       # główny darmowy model etapu 1
# PAID_FAST_MODEL=google/gemini-2.5-flash         # płatny fallback gdy darmowe padną
# VERIFY_MODEL=anthropic/claude-sonnet-5          # mocniejszy model weryfikujący

# Zapas, gdy OpenRouter nie odpowiada
ANTHROPIC_API_KEY=

# =============================================================== ŹRÓDŁA NEWSÓW
# Truth Social (scraper)
SCRAPECREATORS_API_KEY=
# Kongres (planowane)
QUIVER_API_KEY=

# ========================================================= WYSTĄPIENIA NA ŻYWO
# Moduł /live działa tam, gdzie zainstalowano requirements-live.txt i ffmpeg
# (u Ciebie na komputerze). W chmurze go nie ma — to najdroższa rzecz w rachunku.
# LIVE_MODEL=google/gemini-2.5-flash
# LIVE_FALLBACK_MODEL=anthropic/claude-sonnet-5
# LIVE_WHISPER_DEVICE=cpu

# ==================================================================== SERWER
# Katalog na pliki robocze. W chmurze ustawia się sam na /data (dysk Railway).
# PORTEVO_DATA_DIR=

# Port podaje hosting zmienną PORT. Lokalnie domyślnie 8500.
# PANEL_PORT=8500
